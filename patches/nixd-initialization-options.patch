diff --git a/lib/Controller/LifeTime.cpp b/lib/Controller/LifeTime.cpp
index 0aac76d..163a5d5 100644
--- a/lib/Controller/LifeTime.cpp
+++ b/lib/Controller/LifeTime.cpp
@@ -188,13 +188,37 @@ void Controller::
       evalExprWithProgress(*Client, getDefaultNixOSOptionsExpr(),
                            "nixos options");
   }
-  try {
+try {
     Config = parseCLIConfig();
   } catch (LLVMErrorException &Err) {
     lspserver::elog("parse CLI config error: {0}, {1}", Err.what(),
                     Err.takeError());
     std::exit(-1);
   }
+
+  // Clients may also pass their settings as "initializationOptions" on the
+  // initialize request. That is the mechanism the LSP spec describes as primary
+  // and the one editors such as Zed actually populate, but nixd historically
+  // only ever consulted "workspace/configuration". Some clients advertise that
+  // capability without ever answering the request, which would leave the
+  // callback in fetchConfig() below pending forever, so apply these settings
+  // eagerly instead of waiting on it. A real "workspace/configuration" reply
+  // still takes precedence and simply overwrites this.
+  if (Params.rawInitializationOptions) {
+    Configuration InitConfig;
+    llvm::json::Path::Root Root;
+    if (fromJSON(*Params.rawInitializationOptions, InitConfig, Root)) {
+      {
+        std::lock_guard _(ConfigLock);
+        InitOptionsConfig = InitConfig;
+      }
+      if (!isEmptyConfig(InitConfig))
+        updateConfig(std::move(InitConfig));
+    } else {
+      lspserver::elog("initializationOptions: parse error {0}", Root.getError());
+    }
+  }
+
   fetchConfig();
 }
 
