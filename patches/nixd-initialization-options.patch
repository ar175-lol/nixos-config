+bool Controller::isEmptyConfig(const Configuration &C) {
+  // "formatting" has a non-empty default, so it cannot indicate emptiness.
+  return C.options.empty() && C.nixpkgs.expr.empty() &&
+         C.diagnostic.suppress.empty();
+}
+
 void Controller::fetchConfig() {
   auto Action = [this](llvm::Expected<llvm::json::Value> Resp) mutable {
     if (!Resp) {
       elog("workspace/configuration: {0}", Resp.takeError());
+      fallbackToInitOptions("workspace/configuration failed");
       return;
     }
 
@@ -113,6 +120,12 @@ void Controller::fetchConfig() {
         return;
       }
 
+      // A client that supports "workspace/configuration" but answers with an
+      // empty object would otherwise silently override whatever it sent us in
+      // "initializationOptions". Prefer the initialization options in that case.
+      if (isEmptyConfig(NewConfig))
+        fallbackToInitOptions("workspace/configuration returned an empty config");
+
       // OK, update the config
       updateConfig(std::move(NewConfig));
     };
@@ -123,6 +136,19 @@ void Controller::fetchConfig() {
                          std::move(Action));
 }
 
+void Controller::fallbackToInitOptions(std::string_view Reason) {
+  std::optional<Configuration> Fallback;
+  {
+    std::lock_guard G(ConfigLock);
+    if (InitOptionsConfig && !isEmptyConfig(*InitOptionsConfig))
+      Fallback = *InitOptionsConfig;
+  }
+  if (!Fallback)
+    return;
+  lspserver::elog("{0}, falling back to initializationOptions", Reason);
+  updateConfig(std::move(*Fallback));
+}
